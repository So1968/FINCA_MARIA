# FINCA MARIA — exemple de variables Coolify
# Ne jamais committer les vraies valeurs.

# URL publique finale, sans slash terminal
FINCA_PUBLIC_URL=https://finca.example.org
FINCA_ALLOWED_DOMAIN=.example.org

# Image oauth2-proxy : remplacer par une version/digest explicitement validé avant production
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:PIN_ME

# IdP OIDC (recommandé : authentik séparé, avec MFA TOTP obligatoire)
OIDC_ISSUER_URL=https://auth.example.org/application/o/finca-maria/
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME

# Secret de cookie oauth2-proxy, généré aléatoirement et stocké uniquement dans Coolify
OAUTH2_PROXY_COOKIE_SECRET=REPLACE_ME
