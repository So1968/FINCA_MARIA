{
  "name": "finca-maria",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "setup": "npm ci --prefix app && npm ci --prefix server",
    "dev": "npm --prefix app run dev -- --host 127.0.0.1 --port 5173 --strictPort",
