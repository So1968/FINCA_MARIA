    "test": "npm --prefix app test && node --test tests/*.test.mjs",
    "check:family": "npm --prefix app run check:family",
    "test:actions:browser": "node tests/browser/actions.mjs",
    "test:meetings:browser": "node tests/browser/meetings.mjs",
    "test:meeting-audio:browser": "node tests/browser/meeting-audio.mjs",
    "test:meeting-search:browser": "node tests/browser/meeting-search.mjs",
    "test:decision-register:browser": "node tests/browser/decision-register.mjs",
    "start": "bash scripts/ouvrir-cortijo-local.sh",
    "test:meeting-preparation:browser": "node tests/browser/meeting-preparation.mjs",
    "test:account-recovery:api": "node tests/integration/account-recovery.mjs"
  }
}
