# Copier ce fichier en .env sur le serveur et remplacer toutes les valeurs.
# NE JAMAIS committer le vrai .env.

APP_ORIGIN=https://finca.exemple.fr
FINCA_HTTP_PORT=8080

POSTGRES_DB=finca_maria
POSTGRES_USER=finca
# 24 caractères minimum. Avec la composition actuelle, utiliser uniquement A-Z a-z 0-9 . _ ~ -
POSTGRES_PASSWORD=CHANGER_SECRET_BASE_ALEATOIRE_24_CARACTERES_MINIMUM

FINCA_BOOTSTRAP_ADMIN_EMAIL=admin@example.fr
FINCA_BOOTSTRAP_ADMIN_NAME=Administrateur FINCA MARIA
# Utiliser un secret distinct de PostgreSQL.
FINCA_BOOTSTRAP_ADMIN_PASSWORD=CHANGER_MOT_DE_PASSE_ADMIN_LONG_ET_UNIQUE

SESSION_HOURS=12

# Sauvegarde locale automatique de PostgreSQL + BAUL.
# Cette clé chiffre les archives avant leur écriture dans le volume de sauvegarde.
# 32 caractères minimum, secret distinct des autres mots de passe.
BACKUP_ENCRYPTION_PASSPHRASE=CHANGER_CLE_CHIFFREMENT_SAUVEGARDE_32_CARACTERES_MINIMUM
# 86400 = une sauvegarde par jour. Les copies de plus de 14 jours sont supprimées du volume local.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# --- Réunions : transcription locale optionnelle ---
# L'application et l'enregistrement fonctionnent sans ces variables.
# Pour activer Faster-Whisper, démarrer aussi docker-compose.transcription.yml.
FINCA_WHISPER_MODEL=large-v3-turbo
FINCA_WHISPER_DEVICE=cpu
FINCA_WHISPER_COMPUTE=int8
# Pyannote Community-1 demande d'accepter les conditions du modèle puis un jeton Hugging Face.
# Laisser vide désactive uniquement la séparation automatique des voix.
HF_TOKEN=
